# Database configuration for SQLx and your Rust app
# Production URL (via PgBouncer)
DATABASE_URL=postgres://platform_user:secret_password@pgbouncer:5432/platform_db

# Local development URL (direct)
LOCAL_DATABASE_URL=postgres://platform_user:secret_password@db:5432/platform_db

# Secrets for Kubernetes (will be loaded as env vars)
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=secret_password
POSTGRES_DB=platform_db
PGBOUNCER_URL=postgres://platform_user:secret_password@pgbouncer:5432/platform_db

# Runner configuration
PORT=8080
WASM_STORAGE_DIR=./guests_compiled
RUST_LOG=debug
